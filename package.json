{
  "name": "free-oms-app",
  "version": "0.0.6",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "supabase db reset && vitest run --project integration",
    "test:e2e": "supabase db reset && playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "test:db": "supabase test db",
    "test:migration-chain": "node scripts/migration-chain-check.mjs",
    "bootstrap:director": "tsx scripts/bootstrap-director.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "db:advisors": "supabase db lint --level warning && node scripts/run-advisors.mjs",
    "release:check-title": "node scripts/release/controller.mjs check-pr-title",
    "release:preview": "node scripts/release/controller.mjs preview",
    "release:evaluate-build": "node scripts/release/controller.mjs evaluate-build",
    "release:reconcile-builds": "node scripts/release/controller.mjs reconcile-builds",
    "release:prepare": "node scripts/release/controller.mjs prepare-release",
    "release:evaluate-release": "node scripts/release/controller.mjs evaluate-release",
    "test:release": "vitest run --project unit tests/unit/release"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "conventional-commits-parser": "7.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "semver": "7.8.5",
    "supabase": "2.113.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  }
}

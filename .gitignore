# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# os files
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# logs
*.log
logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase local temporary files
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

# Free Ventures OMS — environment variable template
#
# Copy to `.env.local` and fill in real values there. `.env.local` is git-ignored.
# This file must only ever contain variable NAMES — never real values.

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (Supabase secret / service-role key, database URLs, etc.)
# must NEVER be added to this file and must NEVER use the NEXT_PUBLIC_ prefix.
# Set them only in `.env.local` or in the hosting provider's environment settings.

# Free Ventures OMS — environment variable template
#
# Copy to `.env.local` and fill in real values there. `.env.local` is git-ignored.
# This file must only ever contain variable NAMES — never real values.

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key, `sb_publishable_…` (safe to expose to the browser; RLS is enforced)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase SECRET key, `sb_secret_…` — SERVER ONLY.
#
# It bypasses RLS and is the only credential that can execute the service-only `api` bridge, so it
# must never carry a NEXT_PUBLIC_ prefix, never appear in a browser bundle, a log line, a response
# body, or a tracked file. Set it in `.env.local` or in the hosting provider's environment settings.
#
# A legacy `service_role` JWT (starts `eyJ`) is rejected at startup: use the `sb_secret_…` key.
SUPABASE_SECRET_KEY=

{
  "version": 1,
  "about": "Reviewed test-selection rules. Read with docs/testing-and-release.md. A path no rule below names forces full coverage, and so does any change to this file.",
  "activation": {
    "selectiveEnforcement": true,
    "note": "Pull requests and `npm run check` run what the change's lane needs (docs, screen, app-wide or critical). Pushes to main and release candidates still run everything. Set this to false to return every gate to full execution; that edit forces full coverage by itself."
  },
  "suites": {
    "unit": ["tests/unit/**/*.test.{ts,tsx}"],
    "integration": ["tests/integration/**/*.test.ts"],
    "e2e": ["e2e/**/*.spec.ts"],
    "pgtap": ["supabase/tests/database/*.sql"]
  },
  "minimums": {
    "migrations": 57,
    "pgtapFiles": 30,
    "pgtapAssertions": 2073,
    "migrationChainCounterexamples": 174,
    "responsiveProjects": ["mobile", "tablet", "desktop"]
  },
  "retiredTests": [],
  "e2eShardMinutes": 6,
  "e2eMinutes": {
    "about": "Minutes each spec took on all three projects in the full local run of 16 October 2026. Used only to balance E2E shards; a spec not named here counts as 2.",
    "e2e/authentication.spec.ts": 1.3,
    "e2e/catalogue.spec.ts": 4.6,
    "e2e/imprest-daily-count.spec.ts": 1.9,
    "e2e/imprest-disbursements.spec.ts": 2.0,
    "e2e/imprest-funding.spec.ts": 3.6,
    "e2e/imprest-not-counted.spec.ts": 1.2,
    "e2e/imprest-raised-approval.spec.ts": 1.4,
    "e2e/imprest-retirement.spec.ts": 1.3,
    "e2e/imprest-reversal.spec.ts": 1.2,
    "e2e/imprest-send-back.spec.ts": 1.5,
    "e2e/imprest-settlement.spec.ts": 2.2,
    "e2e/imprest-stock-receipt-link.spec.ts": 0.8,
    "e2e/imprest-verification.spec.ts": 1.1,
    "e2e/interaction-feedback.spec.ts": 1.2,
    "e2e/inventory.spec.ts": 3.4,
    "e2e/production.spec.ts": 3.6,
    "e2e/pwa.spec.ts": 0.2,
    "e2e/report-imprest.spec.ts": 0.4,
    "e2e/reports.spec.ts": 3.2,
    "e2e/responsive-shell.spec.ts": 0.6,
    "e2e/role-routing.spec.ts": 0.8,
    "e2e/sales.spec.ts": 4.2,
    "e2e/settlement.spec.ts": 5.5,
    "e2e/stock-invariant.spec.ts": 1.0,
    "e2e/stock-mobile-benchmark.spec.ts": 0.1,
    "e2e/till-count.spec.ts": 2.0
  },
  "benchmarks": {
    "flag": "FV_BENCHMARK=1",
    "developmentGate": "opt-in; the reviewed skips in known-skips.json apply",
    "releaseGate": "always applicable: each file below runs alone after its own reset (scripts/testing/benchmarks.mjs), never inside the main suite, and a benchmark skipped in the main run is accepted only when it passed there",
    "e2e": [
      { "file": "e2e/imprest-daily-count.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-disbursements.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-funding.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-not-counted.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-raised-approval.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-retirement.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-reversal.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-send-back.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-settlement.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-stock-receipt-link.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/imprest-verification.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/report-imprest.spec.ts", "grep": "mobile benchmark" },
      { "file": "e2e/stock-mobile-benchmark.spec.ts", "grep": "phone over 4G" },
      { "file": "e2e/till-count.spec.ts", "grep": "mobile benchmark" }
    ],
    "integration": [{ "file": "tests/integration/stock-benchmark.test.ts" }]
  },
  "forceFull": [
    { "pattern": "supabase/**", "reason": "migrations, database tests, release checks and stack configuration" },
    { "pattern": "scripts/**", "reason": "release, migration-chain and test infrastructure" },
    { "pattern": ".github/**", "reason": "CI workflow" },
    { "pattern": "{package.json,package-lock.json}", "reason": "dependencies or scripts" },
    { "pattern": "{.env.example,.gitignore}", "reason": "what the checkout holds and what the stack reads" },
    { "pattern": "{vitest.config.mts,playwright.config.ts}", "reason": "test runner configuration" },
    { "pattern": "tests/setup/**", "reason": "global test setup" },
    { "pattern": "tests/support/**", "reason": "shared test support" },
    { "pattern": "tests/integration/helpers.ts", "reason": "shared integration helpers" },
    { "pattern": "e2e/{fixtures.ts,global-setup.ts,receipt-photo.ts}", "reason": "shared E2E fixtures" },
    { "pattern": "vercel.json", "reason": "deployment configuration" }
  ],
  "appCritical": [
    { "pattern": "{next.config.ts,proxy.ts,tsconfig.json,eslint.config.mjs,postcss.config.mjs,components.json}", "reason": "application or build configuration" },
    { "pattern": "lib/{auth,admin,supabase}/**", "reason": "authentication, authorization or the database client" },
    { "pattern": "lib/{accountability,imprest,inventory,production,sales,settlement,till,validation}/**", "reason": "financial or stock commands and their validation" },
    { "pattern": "lib/{money.ts,time/**,stock-refusal.ts}", "reason": "business money, date or stock helpers" },
    { "pattern": "lib/env.ts", "reason": "environment the server and the build read" },
    { "pattern": "app/**/actions.ts", "reason": "server actions run financial, stock or account commands" },
    { "pattern": "app/actions/**", "reason": "shared server actions" },
    { "pattern": "app/(app)/layout.tsx", "reason": "the signed-in layout decides who gets in" },
    { "pattern": "app/{auth,sign-in,first-login,no-access}/**", "reason": "authentication screens" },
    { "pattern": "app/(app)/admin/**", "reason": "account administration" },
    { "pattern": "components/auth/**", "reason": "authentication screens" },
    { "pattern": "public/sw.js", "reason": "the service worker caches every page" }
  ],
  "appWide": [
    { "pattern": "components/ui/**", "reason": "shared interface components reach every screen" },
    { "pattern": "components/{app-shell.tsx,nav-link.tsx,nav-icons.ts,language-switcher.tsx}", "reason": "the shared shell reaches every screen" },
    { "pattern": "lib/{nav.ts,utils.ts,ui/**}", "reason": "shared navigation and interface helpers reach every screen" },
    { "pattern": "app/{layout.tsx,page.tsx,globals.css}", "reason": "the shared layout and styles reach every screen" },
    { "pattern": "app/(app)/{loading.tsx,error.tsx}", "reason": "the shared loading and failure states reach every screen" },
    { "pattern": "{i18n,messages}/**", "reason": "wording reaches every screen, and the specs find controls by it" }
  ],
  "docsOnly": ["README.md", "CHANGELOG.md", "AGENTS.md", "CLAUDE.md", "docs/**"],
  "domains": {
    "accountability-ui": {
      "risk": "medium",
      "sources": [
        "app/(app)/accountability/**"
      ],
      "e2e": [
        "e2e/role-routing.spec.ts",
        "e2e/responsive-shell.spec.ts"
      ]
    },
    "reports-ui": {
      "risk": "medium",
      "sources": ["app/(app)/reports/**", "lib/reports/**"],
      "e2e": ["e2e/reports.spec.ts", "e2e/report-imprest.spec.ts"]
    },
    "catalogue-ui": {
      "risk": "medium",
      "sources": ["app/(app)/settings/products/**", "app/(app)/settings/suppliers/**", "lib/catalogue/**"],
      "e2e": ["e2e/catalogue.spec.ts", "e2e/inventory.spec.ts"]
    },
    "storekeepers-ui": {
      "risk": "medium",
      "sources": ["app/(app)/settings/storekeepers/**"],
      "e2e": ["e2e/settlement.spec.ts"]
    },
    "imprest-ui": {
      "risk": "medium",
      "sources": ["app/(app)/imprest/**"],
      "e2e": [
        "e2e/imprest-daily-count.spec.ts",
        "e2e/imprest-disbursements.spec.ts",
        "e2e/imprest-funding.spec.ts",
        "e2e/imprest-not-counted.spec.ts",
        "e2e/imprest-raised-approval.spec.ts",
        "e2e/imprest-retirement.spec.ts",
        "e2e/imprest-reversal.spec.ts",
        "e2e/imprest-send-back.spec.ts",
        "e2e/imprest-settlement.spec.ts",
        "e2e/imprest-stock-receipt-link.spec.ts",
        "e2e/imprest-verification.spec.ts",
        "e2e/report-imprest.spec.ts"
      ]
    },
    "inventory-ui": {
      "risk": "medium",
      "sources": ["app/(app)/inventory/**", "components/inventory/**"],
      "e2e": ["e2e/inventory.spec.ts", "e2e/stock-invariant.spec.ts", "e2e/imprest-stock-receipt-link.spec.ts"]
    },
    "production-ui": {
      "risk": "medium",
      "sources": ["app/(app)/production/**"],
      "e2e": ["e2e/production.spec.ts", "e2e/stock-invariant.spec.ts"]
    },
    "orders-ui": {
      "risk": "medium",
      "sources": ["app/(app)/orders/**"],
      "e2e": ["e2e/sales.spec.ts", "e2e/settlement.spec.ts"]
    },
    "payments-ui": {
      "risk": "medium",
      "sources": ["app/(app)/payments/**", "app/(app)/dispatch/**"],
      "e2e": ["e2e/settlement.spec.ts", "e2e/sales.spec.ts"]
    },
    "dashboard": {
      "risk": "low",
      "sources": ["app/(app)/dashboard/**"],
      "e2e": ["e2e/role-routing.spec.ts", "e2e/responsive-shell.spec.ts"]
    },
    "till-ui": {
      "risk": "medium",
      "sources": ["app/(app)/till/**"],
      "e2e": ["e2e/till-count.spec.ts"]
    },
    "pwa": {
      "risk": "low",
      "sources": ["app/manifest.ts", "app/favicon.ico", "components/pwa/**", "public/icons/**", "public/brand/**", "public/*.svg"],
      "e2e": ["e2e/pwa.spec.ts", "e2e/authentication.spec.ts"]
    },
    "brand": {
      "risk": "low",
      "sources": ["components/brand/**"],
      "e2e": ["e2e/authentication.spec.ts", "e2e/responsive-shell.spec.ts"]
    }
  },
  "groups": {
    "integration": {
      "imprest-fund": {
        "why": "One active fund, one Auth instance and one database. Funding must run first so its first-open race starts with no fund; the not-counted file runs late and retirement runs last, followed only by accountability decisions on a fund of their own (vitest.config.mts).",
        "files": [
          "tests/integration/accountability-decisions.test.ts",
          "tests/integration/imprest-daily-count.test.ts",
          "tests/integration/imprest-disbursements.test.ts",
          "tests/integration/imprest-funding.test.ts",
          "tests/integration/imprest-lost-response.test.ts",
          "tests/integration/imprest-not-counted.test.ts",
          "tests/integration/imprest-raised-approval.test.ts",
          "tests/integration/imprest-retirement.test.ts",
          "tests/integration/imprest-reversal.test.ts",
          "tests/integration/imprest-send-back.test.ts",
          "tests/integration/imprest-settlement.test.ts",
          "tests/integration/imprest-stock-receipt-link.test.ts",
          "tests/integration/imprest-verification.test.ts",
          "tests/integration/report-imprest.test.ts",
          "tests/integration/reports.test.ts"
        ]
      },
      "seeded-stock": {
        "why": "Stock invariant tests share seeded products, locations and ledger rows with production, sales, settlement and report tests.",
        "files": [
          "tests/integration/catalogue.test.ts",
          "tests/integration/counting-units.test.ts",
          "tests/integration/imprest-disbursements.test.ts",
          "tests/integration/imprest-stock-receipt-link.test.ts",
          "tests/integration/inventory.test.ts",
          "tests/integration/production.test.ts",
          "tests/integration/regressions.test.ts",
          "tests/integration/report-alerts-paging.test.ts",
          "tests/integration/report-claim-concurrency.test.ts",
          "tests/integration/report-deliveries-paging.test.ts",
          "tests/integration/report-generation-timeout.test.ts",
          "tests/integration/report-lease-expiry.test.ts",
          "tests/integration/reports.test.ts",
          "tests/integration/sales.test.ts",
          "tests/integration/settlement.test.ts",
          "tests/integration/stock-benchmark.test.ts",
          "tests/integration/stock-invariant.test.ts"
        ]
      }
    },
    "e2e": {
      "open-fund": {
        "why": "imprest-funding.spec.ts reads the posted balance of a fund that already exists, and fails alone on a fresh database (10 November 2026: every other spec passed alone on all three projects). imprest-daily-count.spec.ts opens the fund and sorts before it.",
        "files": [
          "e2e/imprest-daily-count.spec.ts",
          "e2e/imprest-funding.spec.ts"
        ]
      }
    }
  },
  "independent": {
    "integration": [
      "tests/integration/api-boundaries.test.ts",
      "tests/integration/authority.test.ts",
      "tests/integration/director-set-concurrency.test.ts",
      "tests/integration/provisioning.test.ts",
      "tests/integration/recovery.test.ts",
      "tests/integration/till-count.test.ts"
    ],
    "e2e": [
      "e2e/authentication.spec.ts",
      "e2e/catalogue.spec.ts",
      "e2e/imprest-disbursements.spec.ts",
      "e2e/imprest-not-counted.spec.ts",
      "e2e/imprest-raised-approval.spec.ts",
      "e2e/imprest-retirement.spec.ts",
      "e2e/imprest-reversal.spec.ts",
      "e2e/imprest-send-back.spec.ts",
      "e2e/imprest-settlement.spec.ts",
      "e2e/imprest-stock-receipt-link.spec.ts",
      "e2e/imprest-verification.spec.ts",
      "e2e/interaction-feedback.spec.ts",
      "e2e/inventory.spec.ts",
      "e2e/production.spec.ts",
      "e2e/pwa.spec.ts",
      "e2e/report-imprest.spec.ts",
      "e2e/reports.spec.ts",
      "e2e/responsive-shell.spec.ts",
      "e2e/role-routing.spec.ts",
      "e2e/sales.spec.ts",
      "e2e/settlement.spec.ts",
      "e2e/stock-invariant.spec.ts",
      "e2e/stock-mobile-benchmark.spec.ts",
      "e2e/till-count.spec.ts"
    ]
  },
  "smoke": {
    "pgtap": [
      "supabase/tests/database/001_authorization.sql",
      "supabase/tests/database/002_first_login_and_bypass.sql",
      "supabase/tests/database/003_grants_rls_hook.sql",
      "supabase/tests/database/004_audit_attribution.sql",
      "supabase/tests/database/006_api_bridge_and_admin.sql",
      "supabase/tests/database/014_stock_invariant.sql"
    ],
    "integration": [
      "tests/integration/api-boundaries.test.ts",
      "tests/integration/authority.test.ts",
      "tests/integration/director-set-concurrency.test.ts",
      "tests/integration/imprest-lost-response.test.ts",
      "tests/integration/recovery.test.ts",
      "tests/integration/stock-invariant.test.ts"
    ],
    "e2e": [
      "e2e/authentication.spec.ts",
      "e2e/interaction-feedback.spec.ts",
      "e2e/responsive-shell.spec.ts",
      "e2e/role-routing.spec.ts"
    ]
  }
}
